   "id": "p1",
   "t": 11.394,
   "phrase": "here",
   "sentence": "In the previous video, I showed how turning the crank on this machine generates 20 different frequencies, also known as harmonics, which are turned into cosines here, multiplied by coefficients.",
   "strength": "weak",
   "segment_id": "s1"
  },
  {
   "id": "p2",
