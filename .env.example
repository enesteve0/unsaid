# Copy to .env (gitignored) and fill in. Never commit real keys.

# Nebius Token Factory (required): https://tokenfactory.nebius.com/project/api-keys
NEBIUS_API_KEY=
# Optional second key, used automatically if the first one is rejected (401/403)
NEBIUS_API_KEY_BACKUP=

# Tavily (context for citations on slides): https://app.tavily.com
TAVILY_API_KEY=

# Provider: tokenfactory (default, required for the hackathon) or nvidia_build (local prompt prototyping only)
PROVIDER=tokenfactory
NVIDIA_API_KEY=

# Optional model chain overrides (comma-separated, first = preferred)
# MODEL_VISION=nvidia/Nemotron-3.5-Super-VL
# MODEL_REASON=nvidia/Nemotron-3-Ultra-550b-a55b,nvidia/nemotron-3-super-120b-a12b
# MODEL_FAST=nvidia/Nemotron-3_5-Lightning,nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# MODEL_CLASSIFY=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B,nvidia/Nemotron-3_5-Lightning

# Operations
DATA_DIR=data
DEMO_MODE=live
JUDGE_CODE=
